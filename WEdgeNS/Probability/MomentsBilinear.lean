import WEdgeNS.Probability.MomentsQuadratic

/-!
# High moments of bilinear forms in independent bounded variables
-/

open MeasureTheory ProbabilityTheory Filter Topology Matrix

noncomputable section

namespace WEdgeNS

section Indep
variable {Ω : Type} [MeasurableSpace Ω] {μ : Measure Ω} {n : ℕ} {a b : Fin n → Ω → ℝ}

omit [MeasurableSpace Ω] in
/-- A product `a i * b i` is measurable for the σ-algebra generated by any family of coordinates
containing both `a i` and `b i`. -/
private lemma momentsBilinear_measurable_mul (T : Set (Fin n ⊕ Fin n)) (i : Fin n)
    (hl : Sum.inl i ∈ T) (hr : Sum.inr i ∈ T) :
    Measurable[⨆ s ∈ T, MeasurableSpace.comap (Sum.elim a b s) inferInstance]
      (fun ω => a i ω * b i ω) := by
  have h1 : Measurable[⨆ s ∈ T, MeasurableSpace.comap (Sum.elim a b s) inferInstance] (a i) :=
    Measurable.of_comap_le (le_iSup₂ (f := fun s (_ : s ∈ T) =>
      MeasurableSpace.comap (Sum.elim a b s) (inferInstance : MeasurableSpace ℝ)) (Sum.inl i) hl)
  have h2 : Measurable[⨆ s ∈ T, MeasurableSpace.comap (Sum.elim a b s) inferInstance] (b i) :=
    Measurable.of_comap_le (le_iSup₂ (f := fun s (_ : s ∈ T) =>
      MeasurableSpace.comap (Sum.elim a b s) (inferInstance : MeasurableSpace ℝ)) (Sum.inr i) hr)
  exact h1.mul h2

/-- The pointwise products `a i * b i` of two families that are jointly independent are
independent. -/
private lemma momentsBilinear_iIndepFun_mul [IsProbabilityMeasure μ]
    (hind : iIndepFun (Sum.elim a b) μ) (ha : ∀ i, Measurable (a i))
    (hb : ∀ i, Measurable (b i)) : iIndepFun (fun i ω => a i ω * b i ω) μ := by
  classical
  have hX : ∀ s, Measurable (Sum.elim a b s) := fun s => by
    rcases s with i | i
    · exact ha i
    · exact hb i
  rw [iIndepFun_iff (fun _ => (inferInstance : MeasurableSpace ℝ))]
  intro S
  induction S using Finset.induction_on with
  | empty => intro f' _; simp
  | insert j S hj ih =>
    intro f' hf'
    rw [Finset.set_biInter_insert, Finset.prod_insert hj]
    set T1 : Set (Fin n ⊕ Fin n) := {s | ∃ i ∈ S, s = Sum.inl i ∨ s = Sum.inr i} with hT1
    set T2 : Set (Fin n ⊕ Fin n) := {Sum.inl j, Sum.inr j} with hT2
    have hdisj : Disjoint T2 T1 := by
      rw [Set.disjoint_left]
      rintro s (rfl | rfl) ⟨i, hi, h | h⟩
      · exact hj (Sum.inl_injective h ▸ hi)
      · exact absurd h Sum.inl_ne_inr
      · exact absurd h Sum.inr_ne_inl
      · exact hj (Sum.inr_injective h ▸ hi)
    have hI := indep_iSup_of_disjoint (m := fun s => MeasurableSpace.comap (Sum.elim a b s)
      (inferInstance : MeasurableSpace ℝ)) (fun s => (hX s).comap_le) hind hdisj
    rw [Indep_iff] at hI
    have hm1 : MeasurableSet[⨆ s ∈ T2, MeasurableSpace.comap (Sum.elim a b s)
        (inferInstance : MeasurableSpace ℝ)] (f' j) :=
      (momentsBilinear_measurable_mul T2 j (by simp [hT2]) (by simp [hT2])).comap_le _
        (hf' j (Finset.mem_insert_self _ _))
    have hm2 : MeasurableSet[⨆ s ∈ T1, MeasurableSpace.comap (Sum.elim a b s)
        (inferInstance : MeasurableSpace ℝ)] (⋂ i ∈ S, f' i) := by
      refine Finset.measurableSet_biInter _ fun i hi => ?_
      exact (momentsBilinear_measurable_mul T1 i ⟨i, hi, Or.inl rfl⟩
        ⟨i, hi, Or.inr rfl⟩).comap_le _ (hf' i (Finset.mem_insert_of_mem hi))
    rw [hI _ _ hm1 hm2, ih fun i hi => hf' i (Finset.mem_insert_of_mem hi)]

/-- Bilinear forms in bounded measurable variables have integrable absolute powers. -/
private lemma momentsBilinear_integrable_pow [IsProbabilityMeasure μ]
    (ha : ∀ i, Measurable (a i)) (hb : ∀ i, Measurable (b i)) {r : ℝ}
    (hba : ∀ i, ∀ᵐ ω ∂μ, |a i ω| ≤ r) (hbb : ∀ i, ∀ᵐ ω ∂μ, |b i ω| ≤ r)
    (g : Fin n → Fin n → ℂ) (m : ℕ) :
    Integrable (fun ω => ‖∑ i, ∑ j, g i j * (a i ω : ℂ) * (b j ω : ℂ)‖ ^ m) μ := by
  have hmeas : Measurable (fun ω => ∑ i, ∑ j, g i j * (a i ω : ℂ) * (b j ω : ℂ)) :=
    Finset.measurable_sum _ fun i _ => Finset.measurable_sum _ fun j _ => by
      have := ha i
      have := hb j
      fun_prop
  refine Integrable.of_bound (hmeas.norm.pow_const m).aestronglyMeasurable
    ((∑ i, ∑ j, ‖g i j‖ * r * r) ^ m) ?_
  filter_upwards [ae_all_iff.mpr hba, ae_all_iff.mpr hbb] with ω h1 h2
  rw [norm_pow, norm_norm]
  refine pow_le_pow_left₀ (norm_nonneg _) ?_ m
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun i _ => ?_)
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => ?_)
  rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
    Real.norm_eq_abs]
  exact mul_le_mul (mul_le_mul_of_nonneg_left (h1 i) (norm_nonneg _)) (h2 j) (abs_nonneg _)
    (mul_nonneg (norm_nonneg _) ((abs_nonneg _).trans (h1 i)))

end Indep

/-- Reindexing a double sum over `Fin (n + n)` as a double sum over `Fin n ⊕ Fin n`. -/
private lemma momentsBilinear_sum_reindex {n : ℕ} {β : Type*} [AddCommMonoid β]
    (F : Fin n ⊕ Fin n → Fin n ⊕ Fin n → β) :
    ∑ u : Fin (n + n), ∑ v : Fin (n + n), F (finSumFinEquiv.symm u) (finSumFinEquiv.symm v) =
      ∑ s, ∑ t, F s t := by
  calc _ = ∑ u : Fin (n + n), ∑ t, F (finSumFinEquiv.symm u) t :=
        Finset.sum_congr rfl fun u _ =>
          finSumFinEquiv.symm.sum_comp (fun t => F (finSumFinEquiv.symm u) t)
    _ = _ := finSumFinEquiv.symm.sum_comp (fun s => ∑ t, F s t)

/-- The block matrix on `Fin n ⊕ Fin n` with `B`, without its diagonal, in the upper right block
and zero elsewhere. -/
private def momentsBilinearBlock {n : ℕ} (B : Fin n → Fin n → ℂ) :
    Fin n ⊕ Fin n → Fin n ⊕ Fin n → ℂ :=
  Sum.elim (fun i => Sum.elim (fun _ => (0 : ℂ)) (fun j => if i = j then 0 else B i j))
    (fun _ => fun _ => 0)

/-- The off-diagonal quadratic form of the block matrix in the concatenated family is the
off-diagonal part of the bilinear form. -/
private lemma momentsBilinear_block_form {Ω : Type} {n : ℕ} (a b : Fin n → Ω → ℝ)
    (B : Fin n → Fin n → ℂ) (ω : Ω) :
    ∑ u : Fin (n + n), ∑ v : Fin (n + n),
      (if u = v then 0 else momentsBilinearBlock B (finSumFinEquiv.symm u) (finSumFinEquiv.symm v) *
        (Sum.elim a b (finSumFinEquiv.symm u) ω : ℂ) *
        (Sum.elim a b (finSumFinEquiv.symm v) ω : ℂ)) =
    ∑ i, ∑ j, (if i = j then 0 else B i j * (a i ω : ℂ) * (b j ω : ℂ)) := by
  have h := momentsBilinear_sum_reindex (fun s t => if s = t then (0 : ℂ) else
    momentsBilinearBlock B s t * (Sum.elim a b s ω : ℂ) * (Sum.elim a b t ω : ℂ))
  simp only [Equiv.apply_eq_iff_eq] at h
  rw [h]
  simp [Fintype.sum_sum_type, momentsBilinearBlock]

/-- Every entry of the block matrix is at most the off-diagonal supremum of `B`. -/
private lemma momentsBilinear_block_sup {n : ℕ} (B : Fin n → Fin n → ℂ) :
    (⨆ u : Fin (n + n), ⨆ v : Fin (n + n), if u = v then 0 else
      ‖momentsBilinearBlock B (finSumFinEquiv.symm u) (finSumFinEquiv.symm v)‖) ≤
    ⨆ i, ⨆ j, if i = j then 0 else ‖B i j‖ := by
  have h0 : 0 ≤ ⨆ i, ⨆ j, if i = j then (0 : ℝ) else ‖B i j‖ :=
    Real.iSup_nonneg fun i => Real.iSup_nonneg fun j => by split_ifs <;> simp
  have hle : ∀ i j, i ≠ j → ‖B i j‖ ≤ ⨆ i, ⨆ j, if i = j then (0 : ℝ) else ‖B i j‖ := by
    intro i j hij
    have h1 : (if i = j then 0 else ‖B i j‖) ≤ ⨆ j, if i = j then (0 : ℝ) else ‖B i j‖ :=
      le_ciSup (f := fun j => if i = j then (0 : ℝ) else ‖B i j‖) (Finite.bddAbove_range _) j
    have h2 : (⨆ j, if i = j then (0 : ℝ) else ‖B i j‖) ≤
        ⨆ i, ⨆ j, if i = j then (0 : ℝ) else ‖B i j‖ :=
      le_ciSup (f := fun i => ⨆ j, if i = j then (0 : ℝ) else ‖B i j‖)
        (Finite.bddAbove_range _) i
    rw [ite_eq_right hij] at h1
    exact h1.trans h2
  refine Real.iSup_le (fun u => Real.iSup_le (fun v => ?_) h0) h0
  split_ifs with huv
  · exact h0
  · generalize finSumFinEquiv.symm u = s
    generalize finSumFinEquiv.symm v = t
    rcases s with i | i <;> rcases t with j | j <;> simp only [momentsBilinearBlock,
      Sum.elim_inl, Sum.elim_inr, norm_zero, h0]
    by_cases hij : i = j
    · simp [hij, h0]
    · simpa [hij] using hle i j hij

/-- The Hilbert–Schmidt sum of the block matrix is at most that of `B`. -/
private lemma momentsBilinear_block_hs {n : ℕ} (B : Fin n → Fin n → ℂ) :
    (∑ u : Fin (n + n), ∑ v : Fin (n + n), if u = v then 0 else
      ‖momentsBilinearBlock B (finSumFinEquiv.symm u) (finSumFinEquiv.symm v)‖ ^ 2) ≤
    ∑ i, ∑ j, ‖B i j‖ ^ 2 := by
  have h := momentsBilinear_sum_reindex (fun s t => if s = t then (0 : ℝ) else
    ‖momentsBilinearBlock B s t‖ ^ 2)
  simp only [Equiv.apply_eq_iff_eq] at h
  rw [h]
  simp only [Fintype.sum_sum_type, momentsBilinearBlock, Sum.elim_inl, Sum.elim_inr]
  simp only [reduceCtorEq, ite_false, Sum.inl.injEq, Sum.inr.injEq, norm_zero, ne_eq,
    OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, ite_self, Finset.sum_const_zero, zero_add,
    add_zero, ge_iff_le]
  refine Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => ?_
  split_ifs <;> simp

/-- `(x + y) ^ m ≤ 2 ^ m * (x ^ m + y ^ m)` for `x, y ≥ 0`. -/
private lemma momentsBilinear_add_pow_le {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) (m : ℕ) :
    (x + y) ^ m ≤ 2 ^ m * (x ^ m + y ^ m) := by
  have hm : x + y ≤ 2 * max x y := by linarith [le_max_left x y, le_max_right x y]
  calc (x + y) ^ m ≤ (2 * max x y) ^ m := pow_le_pow_left₀ (by positivity) hm m
    _ = 2 ^ m * max x y ^ m := mul_pow _ _ _
    _ ≤ 2 ^ m * (x ^ m + y ^ m) := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        rcases max_choice x y with h | h <;> rw [h]
        · linarith [pow_nonneg hy m]
        · linarith [pow_nonneg hx m]

/-- The arithmetic of the final constant. -/
private lemma momentsBilinear_combine {C0 C1 K C X Y Z p : ℝ} (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hK : 0 < K) (hX : 0 ≤ X) (hY : 0 ≤ Y) (hZ : 0 ≤ Z) (hp : 1 ≤ p)
    (hC : C = 2 * C0 * (1 + K) + 2 * C1 + 1) :
    2 * (C0 * p * (X + K * Z) + (C1 * p) ^ 2 * (Y + Z)) ≤ (C * p) ^ 2 * (X + Y + Z) := by
  have hp1 : p ≤ p ^ 2 := by nlinarith
  have hc : 0 ≤ p ^ 2 := by positivity
  have hC2 : 2 * C0 * (1 + K) + 2 * C1 ^ 2 ≤ C ^ 2 := by
    have h1 : 0 ≤ 2 * C0 * (1 + K) := by positivity
    rw [hC]
    nlinarith [sq_nonneg C1]
  have hK0 : 0 ≤ C0 * K := mul_nonneg hC0.le hK.le
  have e1 : C0 * p * (X + K * Z) ≤ C0 * p ^ 2 * (X + K * Z) := by
    gcongr
  have f1 : 0 ≤ C ^ 2 - 2 * C0 := by nlinarith [sq_nonneg C1]
  have f2 : 0 ≤ C ^ 2 - 2 * C1 ^ 2 := by nlinarith
  have f3 : 0 ≤ C ^ 2 - 2 * C0 * K - 2 * C1 ^ 2 := by nlinarith
  have g1 := mul_nonneg hc (mul_nonneg hX f1)
  have g2 := mul_nonneg hc (mul_nonneg hY f2)
  have g3 := mul_nonneg hc (mul_nonneg hZ f3)
  nlinarith [g1, g2, g3]

/-- (3.22) of [15] in moment form, with the Hilbert–Schmidt term over all `(i, j)`. -/
theorem moment_bilinear_le (K : ℝ) (hK : 0 < K) : ∃ C > 0, ∀ {Ω : Type} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (n N : ℕ) (a b : Fin n → Ω → ℝ),
    iIndepFun (Sum.elim a b) μ → (∀ i, Measurable (a i)) → (∀ i, Measurable (b i)) →
    (∀ i, ∫ ω, a i ω ∂μ = 0) → (∀ i, ∫ ω, b i ω ∂μ = 0) → ∀ q : ℝ, 0 < q → 1 ≤ q → n ≤ N →
    (∀ i, ∀ᵐ ω ∂μ, |a i ω| ≤ q⁻¹) → (∀ i, ∀ᵐ ω ∂μ, |b i ω| ≤ q⁻¹) →
    (∀ i, ∫ ω, a i ω ^ 2 ∂μ ≤ K / N) → (∀ i, ∫ ω, b i ω ^ 2 ∂μ ≤ K / N) →
    ∀ (B : Fin n → Fin n → ℂ) (p : ℕ), 1 ≤ p →
      ∫ ω, ‖∑ i, ∑ j, B i j * a i ω * b j ω‖ ^ (2 * p) ∂μ ≤
        (C * p) ^ (4 * p) * ((⨆ i, ‖B i i‖) / q ^ 2 +
          (⨆ i, ⨆ j, if i = j then 0 else ‖B i j‖) / q +
          Real.sqrt (((N : ℝ) ^ 2)⁻¹ * ∑ i, ∑ j, ‖B i j‖ ^ 2)) ^ (2 * p) := by
  obtain ⟨C0, hC0, hlin⟩ := moment_linear_le
  obtain ⟨C1, hC1, hquad⟩ := moment_quadratic_le (2 * K) (by positivity)
  refine ⟨2 * C0 * (1 + K) + 2 * C1 + 1, by positivity, ?_⟩
  intro Ω _ μ _ n N a b hind ha hb ha0 hb0 q hq hq1 hnN hbda hbdb hvara hvarb B p hp
  set C : ℝ := 2 * C0 * (1 + K) + 2 * C1 + 1 with hCdef
  set sB : ℝ := ⨆ i, ⨆ j, if i = j then 0 else ‖B i j‖ with hsBdef
  set sd : ℝ := ⨆ i, ‖B i i‖ with hsddef
  set Z : ℝ := Real.sqrt (((N : ℝ) ^ 2)⁻¹ * ∑ i, ∑ j, ‖B i j‖ ^ 2) with hZdef
  have hsB0 : 0 ≤ sB := Real.iSup_nonneg fun i => Real.iSup_nonneg fun j => by
    split_ifs <;> simp
  have hsd0 : 0 ≤ sd := Real.iSup_nonneg fun i => norm_nonneg _
  have hZ0 : 0 ≤ Z := Real.sqrt_nonneg _
  have hX0 : 0 ≤ sd / q ^ 2 := by positivity
  have hY0 : 0 ≤ sB / q := by positivity
  have hp2 : 2 * p ≠ 0 := by omega
  have hZsq : Z ^ 2 = ((N : ℝ) ^ 2)⁻¹ * ∑ i, ∑ j, ‖B i j‖ ^ 2 :=
    Real.sq_sqrt (mul_nonneg (by positivity) (Finset.sum_nonneg fun i _ =>
      Finset.sum_nonneg fun j _ => by positivity))
  set D : Ω → ℂ := fun ω => ∑ i, B i i * ((a i ω * b i ω : ℝ) : ℂ) with hDdef
  set O : Ω → ℂ := fun ω => ∑ i, ∑ j, (if i = j then 0 else B i j * (a i ω : ℂ) * (b j ω : ℂ))
    with hOdef
  -- decomposition of the form
  have hdecomp : ∀ ω, ∑ i, ∑ j, B i j * (a i ω : ℂ) * (b j ω : ℂ) = D ω + O ω := by
    intro ω
    simp only [hDdef, hOdef]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    have h1 : ∀ j, B i j * (a i ω : ℂ) * (b j ω : ℂ) =
        (if i = j then B i j * (a i ω : ℂ) * (b j ω : ℂ) else 0) +
          (if i = j then 0 else B i j * (a i ω : ℂ) * (b j ω : ℂ)) := by
      intro j; split_ifs <;> simp
    rw [Finset.sum_congr rfl fun j _ => h1 j, Finset.sum_add_distrib, Finset.sum_ite_eq]
    simp only [Finset.mem_univ, ite_true]
    push_cast
    ring
  -- bilinear forms with the diagonal part and the off-diagonal part
  have hDform : ∀ ω, D ω = ∑ i, ∑ j, (if i = j then B i j else 0) * (a i ω : ℂ) * (b j ω : ℂ) := by
    intro ω
    simp only [hDdef]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [ite_mul, zero_mul]
    rw [Finset.sum_ite_eq]
    simp only [Finset.mem_univ, ite_true]
    push_cast
    ring
  have hOform : ∀ ω, O ω = ∑ i, ∑ j, (if i = j then 0 else B i j) * (a i ω : ℂ) * (b j ω : ℂ) := by
    intro ω
    simp only [hOdef]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    split_ifs <;> simp
  have hDi : Integrable (fun ω => ‖D ω‖ ^ (2 * p)) μ := by
    simp only [hDform]
    exact momentsBilinear_integrable_pow ha hb hbda hbdb _ _
  have hOi : Integrable (fun ω => ‖O ω‖ ^ (2 * p)) μ := by
    simp only [hOform]
    exact momentsBilinear_integrable_pow ha hb hbda hbdb _ _
  -- the diagonal part
  have hI : ∀ i, IndepFun (a i) (b i) μ := fun i => by
    have := hind.indepFun (by simp : (Sum.inl i : Fin n ⊕ Fin n) ≠ Sum.inr i)
    simpa using this
  have hcind := momentsBilinear_iIndepFun_mul hind ha hb
  have hcmeas : ∀ i, Measurable (fun ω => a i ω * b i ω) := fun i => (ha i).mul (hb i)
  have hc0 : ∀ i, ∫ ω, a i ω * b i ω ∂μ = 0 := fun i => by
    rw [(hI i).integral_fun_mul_eq_mul_integral (ha i).aestronglyMeasurable
      (hb i).aestronglyMeasurable, ha0, hb0, zero_mul]
  have hcbd : ∀ i, ∀ᵐ ω ∂μ, |a i ω * b i ω| ≤ (q ^ 2)⁻¹ := fun i => by
    filter_upwards [hbda i, hbdb i] with ω h1 h2
    rw [abs_mul, sq, mul_inv]
    exact mul_le_mul h1 h2 (abs_nonneg _) ((abs_nonneg _).trans h1)
  have hcvar : ∀ i, ∫ ω, (a i ω * b i ω) ^ 2 ∂μ ≤ (K / N) ^ 2 := fun i => by
    have hI2 : IndepFun (fun ω => a i ω ^ 2) (fun ω => b i ω ^ 2) μ :=
      (hI i).comp (measurable_id.pow_const 2) (measurable_id.pow_const 2)
    have e : ∫ ω, (a i ω * b i ω) ^ 2 ∂μ = (∫ ω, a i ω ^ 2 ∂μ) * ∫ ω, b i ω ^ 2 ∂μ := by
      simp only [mul_pow]
      exact hI2.integral_fun_mul_eq_mul_integral ((ha i).pow_const 2).aestronglyMeasurable
        ((hb i).pow_const 2).aestronglyMeasurable
    rw [e, sq]
    exact mul_le_mul (hvara i) (hvarb i) (integral_nonneg fun ω => sq_nonneg _)
      ((integral_nonneg fun ω => sq_nonneg _).trans (hvara i))
  have hD1 := hlin μ n (fun i ω => a i ω * b i ω) hcind hcmeas hc0 (q ^ 2) ((K / N) ^ 2)
    (by positivity) hcbd hcvar (fun i => B i i) p hp
  have hDZ : Real.sqrt ((K / N) ^ 2 * ∑ i, ‖B i i‖ ^ 2) ≤ K * Z := by
    rw [Real.sqrt_le_iff]
    refine ⟨mul_nonneg hK.le hZ0, ?_⟩
    have key : ∑ i, ‖B i i‖ ^ 2 ≤ ∑ i, ∑ j, ‖B i j‖ ^ 2 :=
      Finset.sum_le_sum fun i _ => Finset.single_le_sum (f := fun j => ‖B i j‖ ^ 2)
        (fun j _ => by positivity) (Finset.mem_univ i)
    calc (K / N) ^ 2 * ∑ i, ‖B i i‖ ^ 2 ≤ (K / N) ^ 2 * ∑ i, ∑ j, ‖B i j‖ ^ 2 :=
          mul_le_mul_of_nonneg_left key (by positivity)
      _ = (K * Z) ^ 2 := by rw [mul_pow, hZsq]; ring
  have hD : ∫ ω, ‖D ω‖ ^ (2 * p) ∂μ ≤ (C0 * p * (sd / q ^ 2 + K * Z)) ^ (2 * p) := by
    refine hD1.trans ?_
    rw [mul_pow (C0 * (p : ℝ))]
    refine mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (add_nonneg hX0 (Real.sqrt_nonneg _))
      (add_le_add le_rfl hDZ) _) (by positivity)
  -- the off-diagonal part
  have hkey : ∀ (P : (Ω → ℝ) → Prop), (∀ i, P (a i)) → (∀ i, P (b i)) →
      ∀ u : Fin (n + n), P (Sum.elim a b (finSumFinEquiv.symm u)) := by
    intro P h1 h2 u
    generalize finSumFinEquiv.symm u = s
    rcases s with i | i
    · exact h1 i
    · exact h2 i
  have hxind : iIndepFun (fun u : Fin (n + n) => Sum.elim a b (finSumFinEquiv.symm u)) μ :=
    hind.precomp finSumFinEquiv.symm.injective
  have hxvar : ∀ u : Fin (n + n), ∫ ω, Sum.elim a b (finSumFinEquiv.symm u) ω ^ 2 ∂μ ≤
      2 * K / ((2 * N : ℕ) : ℝ) := by
    have e : 2 * K / ((2 * N : ℕ) : ℝ) = K / N := by
      push_cast
      exact mul_div_mul_left K (N : ℝ) two_ne_zero
    rw [e]
    exact hkey (fun f => ∫ ω, f ω ^ 2 ∂μ ≤ K / N) hvara hvarb
  have hO1 := hquad μ (n + n) (2 * N) (fun u => Sum.elim a b (finSumFinEquiv.symm u)) hxind
    (hkey Measurable ha hb) (hkey (fun f => ∫ ω, f ω ∂μ = 0) ha0 hb0) q hq hq1 (by omega)
    (hkey (fun f => ∀ᵐ ω ∂μ, |f ω| ≤ q⁻¹) hbda hbdb) hxvar
    (fun u v => momentsBilinearBlock B (finSumFinEquiv.symm u) (finSumFinEquiv.symm v)) p hp
  simp only [momentsBilinear_block_form] at hO1
  have hinv : (((2 * N : ℕ) : ℝ) ^ 2)⁻¹ ≤ ((N : ℝ) ^ 2)⁻¹ := by
    have h0 : (0 : ℝ) ≤ ((N : ℝ) ^ 2)⁻¹ := by positivity
    have : (((2 * N : ℕ) : ℝ) ^ 2)⁻¹ = (1 / 4) * ((N : ℝ) ^ 2)⁻¹ := by
      push_cast
      rw [mul_pow, mul_inv]
      norm_num
    rw [this]
    linarith
  have hsq : Real.sqrt ((((2 * N : ℕ) : ℝ) ^ 2)⁻¹ * ∑ u : Fin (n + n), ∑ v : Fin (n + n),
      if u = v then 0 else ‖momentsBilinearBlock B (finSumFinEquiv.symm u)
        (finSumFinEquiv.symm v)‖ ^ 2) ≤ Z :=
    Real.sqrt_le_sqrt (mul_le_mul hinv (momentsBilinear_block_hs B)
      (Finset.sum_nonneg fun u _ => Finset.sum_nonneg fun v _ => by split_ifs <;> positivity)
      (by positivity))
  have hsup := momentsBilinear_block_sup B
  have hO : ∫ ω, ‖O ω‖ ^ (2 * p) ∂μ ≤ ((C1 * p) ^ 2 * (sB / q + Z)) ^ (2 * p) := by
    have hrw : ((C1 * p) ^ 2 * (sB / q + Z)) ^ (2 * p) =
        (C1 * p) ^ (4 * p) * (sB / q + Z) ^ (2 * p) := by
      rw [mul_pow, ← pow_mul]
      ring_nf
    rw [hrw]
    refine hO1.trans (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (add_nonneg
      (div_nonneg (Real.iSup_nonneg fun u => Real.iSup_nonneg fun v => by
        split_ifs <;> positivity) hq.le) (Real.sqrt_nonneg _)) (add_le_add
      (div_le_div_of_nonneg_right hsup hq.le) hsq) _) (by positivity))
  -- combination
  set U : ℝ := C0 * p * (sd / q ^ 2 + K * Z) with hUdef
  set V : ℝ := (C1 * p) ^ 2 * (sB / q + Z) with hVdef
  have hU0 : 0 ≤ U := by positivity
  have hV0 : 0 ≤ V := by positivity
  have hpt : ∀ ω, ‖∑ i, ∑ j, B i j * (a i ω : ℂ) * (b j ω : ℂ)‖ ^ (2 * p) ≤
      2 ^ (2 * p) * (‖D ω‖ ^ (2 * p) + ‖O ω‖ ^ (2 * p)) := by
    intro ω
    rw [hdecomp ω]
    exact (pow_le_pow_left₀ (norm_nonneg _) (norm_add_le _ _) _).trans
      (momentsBilinear_add_pow_le (norm_nonneg _) (norm_nonneg _) _)
  have hUV : 2 * (U + V) ≤ (C * p) ^ 2 * (sd / q ^ 2 + sB / q + Z) :=
    momentsBilinear_combine hC0 hC1 hK hX0 hY0 hZ0 (by exact_mod_cast hp) hCdef
  calc ∫ ω, ‖∑ i, ∑ j, B i j * (a i ω : ℂ) * (b j ω : ℂ)‖ ^ (2 * p) ∂μ
      ≤ ∫ ω, 2 ^ (2 * p) * (‖D ω‖ ^ (2 * p) + ‖O ω‖ ^ (2 * p)) ∂μ :=
        integral_mono_of_nonneg (Eventually.of_forall fun ω => by positivity)
          ((hDi.add hOi).const_mul _) (Eventually.of_forall hpt)
    _ = 2 ^ (2 * p) * (∫ ω, ‖D ω‖ ^ (2 * p) ∂μ + ∫ ω, ‖O ω‖ ^ (2 * p) ∂μ) := by
        rw [integral_const_mul, integral_add hDi hOi]
    _ ≤ 2 ^ (2 * p) * (U ^ (2 * p) + V ^ (2 * p)) := by gcongr
    _ ≤ 2 ^ (2 * p) * (U + V) ^ (2 * p) :=
        mul_le_mul_of_nonneg_left (pow_add_pow_le hU0 hV0 hp2) (by positivity)
    _ = (2 * (U + V)) ^ (2 * p) := (mul_pow _ _ _).symm
    _ ≤ ((C * p) ^ 2 * (sd / q ^ 2 + sB / q + Z)) ^ (2 * p) :=
        pow_le_pow_left₀ (by positivity) hUV _
    _ = (C * p) ^ (4 * p) * (sd / q ^ 2 + sB / q + Z) ^ (2 * p) := by
        rw [mul_pow, ← pow_mul]
        ring_nf

/-! ### Checks -/

/-- The fair coin law on `Bool`. -/
private def momentsBilinearCoin : Measure Bool := (2 : ENNReal)⁻¹ • Measure.count

private instance : IsProbabilityMeasure momentsBilinearCoin := by
  constructor
  simp only [momentsBilinearCoin, Measure.smul_apply, Measure.count_univ, smul_eq_mul]
  norm_num
  exact ENNReal.inv_mul_cancel (by norm_num) (by norm_num)

/-- The Rademacher sign attached to a coin. -/
private def momentsBilinearSign (b : Bool) : ℝ := if b then 1 else -1

private lemma momentsBilinear_integral_coin (f : Bool → ℝ) :
    ∫ b, f b ∂momentsBilinearCoin = (f true + f false) / 2 := by
  rw [momentsBilinearCoin, integral_smul_measure, integral_count]
  simp
  ring

private lemma momentsBilinear_integral_rad (s : Fin 2 ⊕ Fin 2) (f : ℝ → ℝ) :
    ∫ ω, f (momentsBilinearSign (ω s)) ∂(Measure.pi fun _ : Fin 2 ⊕ Fin 2 => momentsBilinearCoin) =
      (f 1 + f (-1)) / 2 := by
  have := integral_comp_eval (μ := fun _ : Fin 2 ⊕ Fin 2 => momentsBilinearCoin) (i := s)
    (f := fun b => f (momentsBilinearSign b)) (Measurable.of_discrete).aestronglyMeasurable
  rw [this, momentsBilinear_integral_coin]
  simp [momentsBilinearSign]

/-- Nondegenerate instance: four independent Rademacher signs (`n = N = 2`), `K = 2`, `q = 1`
(the bounds `|a i| ≤ q⁻¹` and `E a i ^ 2 ≤ K / N` are both attained), the matrix of ones
(so that the diagonal, off-diagonal and Hilbert–Schmidt terms are all nonzero), moment order
`2 * 1`. -/
example : ∃ C > 0,
    ∫ ω, ‖∑ i : Fin 2, ∑ j : Fin 2, ![![(1 : ℂ), 1], ![1, 1]] i j *
        momentsBilinearSign (ω (Sum.inl i)) * momentsBilinearSign (ω (Sum.inr j))‖ ^ (2 * 1)
        ∂(Measure.pi fun _ : Fin 2 ⊕ Fin 2 => momentsBilinearCoin) ≤
      (C * (1 : ℕ)) ^ (4 * 1) * ((⨆ i, ‖![![(1 : ℂ), 1], ![1, 1]] i i‖) / 1 ^ 2 +
        (⨆ i, ⨆ j, if i = j then 0 else ‖![![(1 : ℂ), 1], ![1, 1]] i j‖) / 1 +
        Real.sqrt ((((2 : ℕ) : ℝ) ^ 2)⁻¹ * ∑ i : Fin 2, ∑ j : Fin 2,
          ‖![![(1 : ℂ), 1], ![1, 1]] i j‖ ^ 2)) ^ (2 * 1) := by
  obtain ⟨C, hC, h⟩ := moment_bilinear_le 2 two_pos
  refine ⟨C, hC, h (Measure.pi fun _ : Fin 2 ⊕ Fin 2 => momentsBilinearCoin) 2 2
    (fun i ω => momentsBilinearSign (ω (Sum.inl i)))
    (fun i ω => momentsBilinearSign (ω (Sum.inr i))) ?_ ?_ ?_ ?_ ?_ 1 one_pos le_rfl le_rfl
    ?_ ?_ ?_ ?_ _ 1 le_rfl⟩
  · have h := iIndepFun_pi (ι := Fin 2 ⊕ Fin 2) (μ := fun _ => momentsBilinearCoin)
      (X := fun _ => momentsBilinearSign) (fun _ => (Measurable.of_discrete).aemeasurable)
    have e : Sum.elim (fun (i : Fin 2) (ω : Fin 2 ⊕ Fin 2 → Bool) =>
        momentsBilinearSign (ω (Sum.inl i))) (fun (i : Fin 2) (ω : Fin 2 ⊕ Fin 2 → Bool) =>
        momentsBilinearSign (ω (Sum.inr i))) =
        fun (s : Fin 2 ⊕ Fin 2) (ω : Fin 2 ⊕ Fin 2 → Bool) => momentsBilinearSign (ω s) := by
      ext s ω
      rcases s with i | i <;> rfl
    rw [e]
    exact h
  · intro i; exact (Measurable.of_discrete (f := momentsBilinearSign)).comp
      (measurable_pi_apply (Sum.inl i))
  · intro i; exact (Measurable.of_discrete (f := momentsBilinearSign)).comp
      (measurable_pi_apply (Sum.inr i))
  · intro i
    simpa using momentsBilinear_integral_rad (Sum.inl i) id
  · intro i
    simpa using momentsBilinear_integral_rad (Sum.inr i) id
  · intro i
    refine Eventually.of_forall fun ω => ?_
    simp only [momentsBilinearSign, inv_one]
    split_ifs <;> norm_num
  · intro i
    refine Eventually.of_forall fun ω => ?_
    simp only [momentsBilinearSign, inv_one]
    split_ifs <;> norm_num
  · intro i
    rw [momentsBilinear_integral_rad (Sum.inl i) (fun x => x ^ 2)]
    norm_num
  · intro i
    rw [momentsBilinear_integral_rad (Sum.inr i) (fun x => x ^ 2)]
    norm_num

#print axioms moment_bilinear_le

end WEdgeNS
